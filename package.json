{
  "name": "home-assistant-dynamic-adjuster",
  "description": "Home Assistant tool that will adjust settings based on usage patterns.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 0",
    "start": "node src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superflyxxi/home-assistant-dynamic-adjuster.git"
  },
  "author": "SuperFlyXXI",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/superflyxxi/home-assistant-dynamic-adjuster/issues"
  },
  "homepage": "https://github.com/superflyxxi/home-assistant-dynamic-adjuster#readme",
  "dependencies": {
    "axios": "1",
    "config": "4",
    "xo": "^1.2.3"
  },
  "xo": {
    "ignores": [],
    "prettier": true,
    "rules": {
      "unicorn/prevent-abbreviations": [
        "error",
        {
          "replacements": {
            "res": false,
            "req": false,
            "i": false,
            "dir": false,
            "docs": false
          }
        }
      ],
      "new-cap": [
        "error"
      ],
      "guard-for-in": [
        "off"
      ]
    }
  }
}
